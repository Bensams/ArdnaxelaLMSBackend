# Ignore node_modules, if applicable
node_modules/
npm-debug.log
yarn-error.log

# Ignore IDE project files
.idea/
*.iml
.vscode/

# Ignore Java build files
target/
build/
*.war
*.jar

# Ignore version control files
.git/
.gitignore
.gitattributes

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore logs and temporary files
*.log
*.tmp
*.swp
*.bak

# Ignore environment and sensitive configuration files
.env
*.env.*

# Ignore Docker-related files and temporary build files
docker-compose.override.yml
Dockerfile.*

# Ignore database data that might be linked in volumes
postgres-data/
pgadmin-data/

# Ignore any generated files
*.class